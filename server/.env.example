PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/easyprint
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=easyprint_super_secret_jwt_key_2026
OWNER_SEED_PASSWORD=Owner@123
UPLOAD_DIR=./uploads

# Platform Admin Seed Credentials
ADMIN_SEED_EMAIL=admin@easyprint.com
ADMIN_SEED_PASSWORD=Admin@EasyPrint2026!

# File Retention Policy (in hours)
RETENTION_HOURS=24

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_PAYMENT=30
RATE_LIMIT_MAX_UPLOAD=60

# Storage Driver: 'local' (development), 's3' (AWS S3), or 'r2' (Cloudflare R2)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=easyprint-files
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay Payment Gateway (Test mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
