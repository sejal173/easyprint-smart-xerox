PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/easyprint
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=<SECURE_RANDOM_JWT_SECRET_32_CHARS>
OWNER_SEED_EMAIL=owner@example.com
OWNER_SEED_PASSWORD=<OWNER_SEED_PASSWORD>
UPLOAD_DIR=./uploads

# Platform Admin Seed Credentials
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=<ADMIN_SEED_PASSWORD>

# File Retention Policy (in hours)
RETENTION_HOURS=24

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_PAYMENT=30
RATE_LIMIT_MAX_UPLOAD=60

# Dev Payment Simulation Guard (Default false; Refuses boot in production if true)
ALLOW_DEV_PAYMENT_SIMULATION=false

# Storage Driver: 'local' (development), 's3' (AWS S3), or 'r2' (Cloudflare R2)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=easyprint-files
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay Payment Gateway (Test mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
