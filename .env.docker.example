# EasyPrint Docker Compose Environment Variables Reference
# Copy this file to .env.docker before running docker compose:
# cp .env.docker.example .env.docker

# App Environment & Ports
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost

# Database & Queue (Internal Docker Compose network names)
MONGODB_URI=mongodb://mongo:27017/easyprint
REDIS_URL=redis://redis:6379

# Security & Authentication
# Generate a cryptographically secure random secret (min 32 characters)
JWT_SECRET=<SECURE_RANDOM_JWT_SECRET_32_CHARS>

# Initial Seed Credentials (Optional: used only if running npm run seed)
OWNER_SEED_EMAIL=owner@example.com
OWNER_SEED_PASSWORD=<OWNER_SEED_PASSWORD>
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=<ADMIN_SEED_PASSWORD>

# Dev Payment Simulation Guard (MUST be false in production)
ALLOW_DEV_PAYMENT_SIMULATION=false

# File Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=/app/server/uploads
RETENTION_HOURS=24

# Cloud Storage (Optional - required if STORAGE_DRIVER is s3 or r2)
S3_ENDPOINT=
S3_BUCKET=easyprint-files
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay Payments (Optional in development / Required for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rate Limiting & Agent Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_PAYMENT=30
RATE_LIMIT_MAX_UPLOAD=60
AGENT_LEASE_SECONDS=300

