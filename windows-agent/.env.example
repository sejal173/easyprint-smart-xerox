# EasyPrint Windows Printing Agent Environment Reference (.NET 8)
# Configuration is managed via appsettings.json and Windows DPAPI encrypted storage.

EASYPRINT_API_BASE_URL=http://localhost:5000
EASYPRINT_PRINTER_NAME=
EASYPRINT_POLL_INTERVAL_SECONDS=15
EASYPRINT_HEARTBEAT_SECONDS=30
EASYPRINT_LEASE_RENEW_SECONDS=60
EASYPRINT_MAX_ATTEMPTS=3
